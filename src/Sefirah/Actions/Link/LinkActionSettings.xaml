<UserControl
    x:Class="Sefirah.Actions.Link.LinkActionSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Sefirah.Helpers">

    <TextBox
        x:Name="LinkTextBox"
        Header="{helpers:ResourceString Name=Link}"
        PlaceholderText="{helpers:ResourceString Name=EnterLink}"
        TextChanged="LinkTextBox_TextChanged" />
</UserControl>
