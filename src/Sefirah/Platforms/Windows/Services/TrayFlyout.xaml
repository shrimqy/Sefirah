<local:DesktopFlyout
    x:Class="Sefirah.Platforms.Windows.Services.TrayFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Sefirah.Converters"
    xmlns:helpers="using:Sefirah.Helpers"
    xmlns:local="using:DesktopFlyouts"
    xmlns:models="using:Sefirah.Data.Models"
    xmlns:userControls="using:Sefirah.UserControls"
    FlyoutWidth="368">

    <local:DesktopFlyout.Resources>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" Inverse="True" />
    </local:DesktopFlyout.Resources>

    <!--  Island 1: Notifications  -->
    <local:DesktopFlyoutIsland
        x:Name="NotificationIsland"
        IslandHeight="*"
        Visibility="{x:Bind ViewModel.Notifications.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
        <userControls:NotificationsControl
            Margin="12,8,12,0" />
    </local:DesktopFlyoutIsland>

    <!--  Island 2: Media sessions  -->
    <local:DesktopFlyoutIsland
        x:Name="MediaIsland"
        IslandHeight="158"
        Visibility="{x:Bind ViewModel.Device.RemotePlaybackSessions.Count, Converter={StaticResource CountToVisibilityConverter}, Mode=OneWay}">
        <userControls:MediaSessionsControl
            Margin="12,4,12,0" />
    </local:DesktopFlyoutIsland>

    <!--  Island 3: Pinned apps  -->
    <local:DesktopFlyoutIsland
        IslandHeight="Auto"
        Visibility="{x:Bind AppsViewModel.HasPinnedApps, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
        <GridView
            Margin="8"
            Padding="0"
            HorizontalAlignment="Stretch"
            IsItemClickEnabled="True"
            ItemClick="PinnedApp_ItemClick"
            ItemsSource="{x:Bind AppsViewModel.PinnedApps, Mode=OneWay}"
            SelectionMode="None">
            <GridView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                    <Setter Property="Width" Value="52" />
                    <Setter Property="Height" Value="52" />
                    <Setter Property="Margin" Value="2" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:ApplicationItem">
                    <Grid
                        Width="40"
                        Height="40"
                        AutomationProperties.Name="{x:Bind AppName}"
                        ToolTipService.ToolTip="{x:Bind AppName}">
                        <Border
                            CornerRadius="20"
                            Visibility="{x:Bind IsLoading, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <Image
                                Width="40"
                                Height="40"
                                Source="{x:Bind IconPath, Mode=OneWay}"
                                Stretch="UniformToFill" />
                        </Border>
                        <ProgressRing
                            Width="28"
                            Height="28"
                            IsActive="{x:Bind IsLoading, Mode=OneWay}"
                            Visibility="{x:Bind IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </local:DesktopFlyoutIsland>

    <!--  Island 4: Device info + footer  -->
    <local:DesktopFlyoutIsland IslandHeight="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <userControls:DeviceControlCenter
                HorizontalAlignment="Stretch"
                Margin="12"
                PaneFlyoutPlacement="Top" />

            <Border Grid.Row="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

            <Grid Grid.Row="2">
                <StackPanel
                    Margin="6,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Button
                        Width="36"
                        Height="36"
                        Padding="0"
                        AutomationProperties.Name="{helpers:ResourceString Name=Calls}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="Navigate_Click"
                        Tag="Calls"
                        ToolTipService.ToolTip="{helpers:ResourceString Name=Calls}">
                        <FontIcon FontSize="16" Glyph="&#xE717;" />
                    </Button>
                    <Button
                        Width="36"
                        Height="36"
                        Padding="0"
                        AutomationProperties.Name="{helpers:ResourceString Name=Messages}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="Navigate_Click"
                        Tag="Messages"
                        ToolTipService.ToolTip="{helpers:ResourceString Name=Messages}">
                        <FontIcon FontSize="16" Glyph="&#xE8BD;" />
                    </Button>
                    <Button
                        Width="36"
                        Height="36"
                        Padding="0"
                        AutomationProperties.Name="{helpers:ResourceString Name=Apps}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="Navigate_Click"
                        Tag="Apps"
                        ToolTipService.ToolTip="{helpers:ResourceString Name=Apps}">
                        <FontIcon FontSize="16" Glyph="&#xED35;" />
                    </Button>
                </StackPanel>

                <Button
                    Width="36"
                    Height="36"
                    Margin="0,0,6,0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{helpers:ResourceString Name=Settings}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="Navigate_Click"
                    Tag="Settings"
                    ToolTipService.ToolTip="{helpers:ResourceString Name=Settings}">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </Grid>
        </Grid>
    </local:DesktopFlyoutIsland>

</local:DesktopFlyout>
