<Page
    x:Class="Sefirah.Views.MessagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Sefirah.Converters"
    xmlns:wctconverters="using:CommunityToolkit.WinUI.Converters"
    xmlns:data="using:Sefirah.Data.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entity="using:Sefirah.Data.AppDatabase.Models"
    xmlns:controls="using:Sefirah.UserControls"
    xmlns:helpers="using:Sefirah.Helpers"
    xmlns:local="using:Sefirah.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Sefirah.Data.Models.Messages"
    xmlns:vm="using:Sefirah.ViewModels"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" Inverse="True" />
        <converters:EmptyObjectToVisibilityConverter x:Key="EmptyObjectToVisibilityConverter" />
        <converters:EmptyObjectToVisibilityConverter x:Key="InverseEmptyObjectToVisibilityConverter" Inverse="True" />
        <converters:MessageTypeToAlignmentConverter x:Key="MessageTypeToAlignmentConverter" />
        <converters:MessageTypeToVisibilityConverter x:Key="MessageTypeToVisibilityConverter" />
        <converters:InverseMessageTypeToVisibilityConverter x:Key="InverseMessageTypeToVisibilityConverter" />
        <converters:UnixTimestampConverter x:Key="UnixTimestampConverter" />

        <Style x:Key="ComposerIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Background="Transparent"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ContentPresenter>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComposerSendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="OutlineIcon.Visibility" Value="Collapsed" />
                                            <Setter Target="FillIcon.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="OutlineIcon.Visibility" Value="Collapsed" />
                                            <Setter Target="FillIcon.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="OutlineIcon.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            <Setter Target="FillIcon.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <FontIcon
                                x:Name="OutlineIcon"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Foreground="{TemplateBinding Foreground}"
                                Glyph="&#xE724;" />
                            <FontIcon
                                x:Name="FillIcon"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Foreground="{TemplateBinding Foreground}"
                                Glyph="&#xE725;"
                                Visibility="Collapsed" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SimIconComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="SimIcon.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <Setter Target="SignalIcon.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="SimIcon.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <Setter Target="SignalIcon.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="SimIcon.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            <Setter Target="SignalIcon.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid>
                                <FontIcon
                                    x:Name="SimIcon"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Foreground="{TemplateBinding Foreground}"
                                    Glyph="{Binding SelectedPhoneNumber.Glyph}" />
                                <FontIcon
                                    x:Name="SignalIcon"
                                    Margin="7,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Foreground="{TemplateBinding Foreground}"
                                    Glyph="&#xED2A;" />
                            </Grid>
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Opacity="0"
                                Foreground="{TemplateBinding Foreground}">
                                <TextBlock x:Name="PlaceholderTextBlock" Text="{TemplateBinding PlaceholderText}" />
                            </ContentPresenter>
                            <Popup x:Name="Popup">
                                <Border
                                    x:Name="PopupBorder"
                                    MinWidth="220"
                                    Padding="{ThemeResource ComboBoxDropdownBorderPadding}"
                                    Background="{ThemeResource ComboBoxDropDownBackground}"
                                    BorderBrush="{ThemeResource ComboBoxDropDownBorderBrush}"
                                    BorderThickness="{ThemeResource ComboBoxDropdownBorderThickness}"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                                    <ScrollViewer x:Name="ScrollViewer">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <wctconverters:BoolToObjectConverter x:Key="BooleanToTextColorConverter"
            TrueValue="{ThemeResource SystemControlForegroundBaseMediumBrush}"
            FalseValue="{ThemeResource TextFillColorPrimaryBrush}" />

        <DataTemplate x:Key="ConversationSearchSuggestionTemplate" x:DataType="models:Conversation">
            <StackPanel
                Margin="0,8,0,8"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <controls:ContactAvatar
                    Width="36"
                    Height="36"
                    ImageProvider="{x:Bind AvatarStream, Mode=OneWay}"
                    Initials="{x:Bind Initials, Mode=OneWay}"
                    PlaceholderColorHex="{x:Bind PlaceholderColorHex, Mode=OneWay}"
                    IsGroup="{x:Bind IsGroup, Mode=OneWay}" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind DisplayName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Text="{x:Bind LastMessage, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ContactSearchSuggestionTemplate" x:DataType="data:Contact">
            <StackPanel
                Margin="0,8,0,8"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <controls:ContactAvatar
                    Width="36"
                    Height="36"
                    ImageProvider="{x:Bind AvatarStream, Mode=OneWay}"
                    Initials="{x:Bind Initials, Mode=OneWay}"
                    PlaceholderColorHex="{x:Bind PlaceholderColorHex, Mode=OneWay}" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind DisplayName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Text="{x:Bind Address, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MessageItemTemplate" x:DataType="models:Conversation">
            <Grid Height="72" Padding="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:ContactAvatar
                    Grid.Column="0"
                    Width="48"
                    Height="48"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    ImageProvider="{x:Bind AvatarStream}"
                    Initials="{x:Bind Initials}"
                    PlaceholderColorHex="{x:Bind PlaceholderColorHex}"
                    IsGroup="{x:Bind IsGroup}" />

                <!--  Text Column  -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            FontWeight="SemiBold"
                            Foreground="{x:Bind HasRead, Mode=OneWay, Converter={StaticResource BooleanToTextColorConverter}}"
                            Text="{x:Bind DisplayName, Mode=OneWay, FallbackValue='Unknown'}"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            Grid.Column="1"
                            FontSize="12"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Text="{x:Bind LastMessageTimestamp, Mode=OneWay, Converter={StaticResource UnixTimestampConverter}, FallbackValue=''}" />
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        Foreground="{x:Bind HasRead, Mode=OneWay, Converter={StaticResource BooleanToTextColorConverter}}"
                        MaxLines="1"
                        Text="{x:Bind LastMessage, Mode=OneWay, FallbackValue='No content'}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid SizeChanged="Page_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ThreadsColumn" Width="420" />
            <ColumnDefinition x:Name="DetailColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Left panel - Message threads list  -->
        <Grid
            x:Name="ThreadsPane"
            Grid.Column="0"
            BorderBrush="{ThemeResource CardStrokeColorDefault}"
            BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox
                    x:Name="MessagesSearchBox"
                    Margin="16,12,8,12"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Messages AutoSuggestBox"
                    ItemTemplate="{StaticResource ConversationSearchSuggestionTemplate}"
                    PlaceholderText="{helpers:ResourceString Name=SearchMessages}"
                    QueryIcon="Find"
                    QuerySubmitted="SearchBox_QuerySubmitted"
                    TextChanged="SearchBox_TextChanged"
                    UpdateTextOnSelect="False" />

                <Button
                    x:Name="NewMessageButton"
                    Grid.Column="1"
                    Margin="0,12,16,12"
                    Padding="12,8"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.Name="{helpers:ResourceString Name=NewMessage}"
                    Click="NewMessageButton_Click"
                    ToolTipService.ToolTip="{helpers:ResourceString Name=NewMessage}">
                    <FontIcon FontSize="16" Glyph="&#xE932;" />
                </Button>
            </Grid>

            <ListView
                x:Name="MessagesList"
                Grid.Row="1"
                Margin="0,8,0,0"
                IsItemClickEnabled="True"
                ItemClick="MessagesList_ItemClick"
                ItemTemplate="{StaticResource MessageItemTemplate}"
                ItemsSource="{x:Bind ViewModel.Conversations, Mode=OneWay}"
                SelectionMode="None" />
        </Grid>

        <!--  Right panel - Message content  -->
        <Grid
            x:Name="DetailPane"
            Grid.Column="1"
            AllowDrop="True"
            DragOver="Composer_DragOver"
            Drop="Composer_Drop">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Empty state  -->
            <Grid
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RowSpacing="12"
                Visibility="{x:Bind ViewModel.ShouldShowEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon
                    Grid.Row="0"
                    FontSize="50"
                    Glyph="&#xE8F2;" />
                <TextBlock
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    Text="{helpers:ResourceString Name=EmptyMessages}" />
            </Grid>

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsNewConversation, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    Margin="0,0,0,12"
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="{helpers:ResourceString Name=NewMessage}" />
                <TextBlock
                    Margin="20,0"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    Text="{helpers:ResourceString Name=EnterAddressesAndCompose}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Message header  -->
            <Grid Grid.Row="0" Padding="8,12,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="ConversationBackButton"
                        Margin="0,0,4,0"
                        Padding="12,8"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Visibility="Collapsed"
                        Click="ConversationBackButton_Click"
                        AutomationProperties.Name="{helpers:ResourceString Name=Back}"
                        ToolTipService.ToolTip="{helpers:ResourceString Name=Back}">
                        <FontIcon FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE76B;" />
                    </Button>

                    <Grid
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.SelectedConversation, Mode=OneWay, Converter={StaticResource EmptyObjectToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:ContactAvatar
                            Grid.Column="0"
                            Width="36"
                            Height="36"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            ImageProvider="{x:Bind ViewModel.SelectedConversation.AvatarStream, Mode=OneWay}"
                            Initials="{x:Bind ViewModel.SelectedConversation.Initials, Mode=OneWay}"
                            PlaceholderColorHex="{x:Bind ViewModel.SelectedConversation.PlaceholderColorHex, Mode=OneWay}"
                            IsGroup="{x:Bind ViewModel.SelectedConversation.IsGroup, Mode=OneWay}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.SelectedConversation.DisplayName, Mode=OneWay, FallbackValue=''}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.SelectedConversation.SubtitleAddress, Mode=OneWay, FallbackValue=''}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <Grid
                        Grid.Column="1"
                        Visibility="{x:Bind ViewModel.IsNewConversation, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <AutoSuggestBox
                            x:Name="AddressInput"
                            Grid.Row="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="New conversation address input"
                            ItemTemplate="{StaticResource ContactSearchSuggestionTemplate}"
                            PlaceholderText="{helpers:ResourceString Name=AddressInputPlaceholder}"
                            QuerySubmitted="AddressInput_QuerySubmitted"
                            TextChanged="AddressInput_TextChanged"
                            UpdateTextOnSelect="False" />

                        <ListView
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            ItemsSource="{x:Bind ViewModel.NewConversationRecipients, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="data:Contact">
                                    <Border
                                        Padding="4,4"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                                        BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <controls:ContactAvatar
                                                    Grid.Column="0"
                                                    Width="24"
                                                    Height="24"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center"
                                                    ImageProvider="{x:Bind AvatarStream}"
                                                    Initials="{x:Bind Initials}"
                                                    PlaceholderColorHex="{x:Bind PlaceholderColorHex}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind DisplayName}" />
                                            </Grid>
                                            <Button
                                                Grid.Column="1"
                                                MinWidth="24"
                                                MinHeight="24"
                                                Padding="4"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="RemoveAddressButton_Click"
                                                CornerRadius="12"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="{helpers:ResourceString Name=RemoveAddress}">
                                                <FontIcon FontSize="10" Glyph="&#xE711;" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0,2" />
                                    <Setter Property="MinHeight" Value="36" />
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter
                                                    x:Name="ContentPresenter"
                                                    Padding="{TemplateBinding Padding}"
                                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    ContentTransitions="{TemplateBinding ContentTransitions}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>
                </Grid>

                <Rectangle
                    Grid.Row="1"
                    Height="1"
                    Margin="0,20,0,4"
                    Fill="{StaticResource SystemControlForegroundBaseLowBrush}"
                    Visibility="{x:Bind ViewModel.SelectedConversation, Mode=OneWay, Converter={StaticResource EmptyObjectToVisibilityConverter}}" />
            </Grid>

            <!--  Message content  -->
            <ListView
                x:Name="MessagesListView"
                Grid.Row="1"
                Padding="20,0,20,0"
                IsItemClickEnabled="False"
                ItemsSource="{x:Bind ViewModel.MessageGroups, Mode=OneWay}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled"
                SelectionMode="None"
                ShowsScrollingPlaceholders="True"
                SizeChanged="MessagesListView_SizeChanged"

                Visibility="{x:Bind ViewModel.SelectedConversation, Mode=OneWay, Converter={StaticResource EmptyObjectToVisibilityConverter}}">

                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel VerticalAlignment="Bottom" ItemsUpdatingScrollMode="KeepLastItemInView" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:MessageGroup">
                        <StackPanel>
                            <TextBlock
                                Margin="0,12,0,4"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                Text="{x:Bind DateHeader, Mode=OneWay}"
                                Visibility="{x:Bind HasDateHeader, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Grid Margin="0,8">
                            <!--  Received Message Group Layout  -->
                            <Grid
                                MaxWidth="500"
                                HorizontalAlignment="Left"
                                Visibility="{x:Bind IsReceived, Converter={StaticResource BooleanToVisibilityConverter}}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <controls:ContactAvatar
                                    Grid.Column="0"
                                    Width="32"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Top"
                                    ImageProvider="{x:Bind Sender.AvatarStream}"
                                    Initials="{x:Bind Sender.Initials}"
                                    PlaceholderColorHex="{x:Bind Sender.PlaceholderColorHex}" />

                                <StackPanel Grid.Column="1">
                                    <StackPanel
                                        Margin="4,0,0,4"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                            Text="{x:Bind Sender.DisplayName}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                            Text="{x:Bind TimeHeader, Mode=OneWay}" />
                                    </StackPanel>

                                    <!--  Message Bubbles  -->
                                    <ItemsControl ItemsSource="{x:Bind Messages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:Message">
                                                <StackPanel Margin="0,2" HorizontalAlignment="Left" Spacing="4">
                                                    <ItemsControl
                                                        ItemsSource="{x:Bind Attachments}"
                                                        Visibility="{x:Bind HasAttachments, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Spacing="8" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:MessageAttachment">
                                                                <controls:MessageAttachmentView
                                                                    HorizontalAlignment="Left"
                                                                    Attachment="{x:Bind}"
                                                                    Click="OpenAttachment_Click"
                                                                    GifPrefetchRequested="PrefetchGif_Handler"
                                                                    OpenWithClick="OpenAttachmentWith_Click"
                                                                    ShowInFolderClick="ShowAttachmentInFolder_Click" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border
                                                        Padding="12"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        CornerRadius="0,8,8,8"
                                                        Visibility="{x:Bind HasBody, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ToolTipService.ToolTip>
                                                            <ToolTip>
                                                                <TextBlock Text="{x:Bind Timestamp, Converter={StaticResource UnixTimestampConverter}, ConverterParameter='F'}" />
                                                            </ToolTip>
                                                        </ToolTipService.ToolTip>
                                                        <Border.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem
                                                                    Click="CopyMessage_Click"
                                                                    Icon="Copy"
                                                                    Tag="{x:Bind Body}"
                                                                    Text="{helpers:ResourceString Name=CopyMessage}" />
                                                            </MenuFlyout>
                                                        </Border.ContextFlyout>
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                            IsTextSelectionEnabled="True"
                                                            Text="{x:Bind Body}"
                                                            TextWrapping="Wrap" />
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <!--  Sent Message Group Layout  -->
                            <StackPanel
                                MaxWidth="500"
                                HorizontalAlignment="Right"
                                Visibility="{x:Bind IsReceived, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <Grid Margin="0,0,0,4" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        HorizontalAlignment="Right"
                                        FontSize="11"
                                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                        Text="{x:Bind TimeHeader, Mode=OneWay}" />
                                </Grid>

                                <!--  Message Bubbles  -->
                                <ItemsControl ItemsSource="{x:Bind Messages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Message">
                                            <Grid Margin="0,2" HorizontalAlignment="Right" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" HorizontalAlignment="Right" Spacing="4">
                                                    <ItemsControl
                                                        HorizontalAlignment="Right"
                                                        ItemsSource="{x:Bind Attachments}"
                                                        Visibility="{x:Bind HasAttachments, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Spacing="8" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:MessageAttachment">
                                                                <controls:MessageAttachmentView
                                                                    HorizontalAlignment="Right"
                                                                    Attachment="{x:Bind}"
                                                                    Click="OpenAttachment_Click"
                                                                    GifPrefetchRequested="PrefetchGif_Handler"
                                                                    OpenWithClick="OpenAttachmentWith_Click"
                                                                    ShowInFolderClick="ShowAttachmentInFolder_Click" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border
                                                        Padding="12"
                                                        HorizontalAlignment="Right"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="8,8,0,8"
                                                        Visibility="{x:Bind HasBody, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ToolTipService.ToolTip>
                                                            <ToolTip>
                                                                <TextBlock Text="{x:Bind Timestamp, Converter={StaticResource UnixTimestampConverter}, ConverterParameter='F'}" />
                                                            </ToolTip>
                                                        </ToolTipService.ToolTip>
                                                        <Border.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem
                                                                    Click="CopyMessage_Click"
                                                                    Icon="Copy"
                                                                    Tag="{x:Bind Body}"
                                                                    Text="{helpers:ResourceString Name=CopyMessage}" />
                                                            </MenuFlyout>
                                                        </Border.ContextFlyout>
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                            IsTextSelectionEnabled="True"
                                                            SelectionHighlightColor="{ThemeResource SystemControlHighlightListAccentHighBrush}"
                                                            Text="{x:Bind Body}"
                                                            TextWrapping="Wrap" />
                                                    </Border>
                                                </StackPanel>

                                                <Grid
                                                    Grid.Column="1"
                                                    Width="12"
                                                    Height="12"
                                                    VerticalAlignment="Bottom"
                                                    Visibility="{x:Bind ShowSendIndicator, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Ellipse
                                                        Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                        StrokeThickness="1.25" />
                                                    <FontIcon
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="7"
                                                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                        Glyph="&#xE73E;"
                                                        Visibility="{x:Bind ShowSendCheck, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter
                                        x:Name="ContentPresenter"
                                        Padding="{TemplateBinding Padding}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        ContentTransitions="{TemplateBinding ContentTransitions}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!--  Message composer  -->
            <Grid
                Grid.Row="2"
                Padding="20,12"
                Visibility="{x:Bind ViewModel.ShouldShowComposeUI, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    Grid.Row="0"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    Visibility="{x:Bind ViewModel.HasStagedAttachments, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.StagedAttachments, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:StagedAttachment">
                                <Grid Margin="0,0,0,8" Width="120" Height="120">
                                    <Border CornerRadius="8">
                                        <Image
                                            Stretch="UniformToFill"
                                            Source="{x:Bind PreviewImage}"
                                            Visibility="{x:Bind HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Border>
                                    <Border
                                        Padding="8"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        CornerRadius="8"
                                        Visibility="{x:Bind ShowPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind DisplayTitle}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <Button
                                        MinWidth="24"
                                        MinHeight="24"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Click="RemoveStagedAttachment_Click"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="{helpers:ResourceString Name=RemoveAttachment}">
                                        <FontIcon FontSize="10" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="1">
                    <TextBox
                        x:Name="MessageTextBox"
                        MinHeight="40"
                        MaxHeight="100"
                        Padding="12,9,172,9"
                        VerticalContentAlignment="Center"
                        AutomationProperties.Name="Message input"
                        PlaceholderText="{helpers:ResourceString Name=MessagePlaceholder}"
                        PreviewKeyDown="MessageTextBox_KeyDown"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollMode="Auto"
                        Text="{x:Bind ViewModel.MessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />

                    <StackPanel
                        Margin="0,0,6,0"
                        Padding="4,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Orientation="Horizontal"
                        Spacing="6">
                        <win:Button
                            x:Name="EmojiButton"
                            AutomationProperties.Name="{helpers:ResourceString Name=Emoji}"
                            Click="EmojiButton_Click"
                            Style="{StaticResource ComposerIconButtonStyle}"
                            ToolTipService.ToolTip="{helpers:ResourceString Name=Emoji}">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE76E;" />
                        </win:Button>

                        <Button
                            x:Name="AttachButton"
                            AutomationProperties.Name="{helpers:ResourceString Name=AttachFile}"
                            Click="AttachButton_Click"
                            Style="{StaticResource ComposerIconButtonStyle}"
                            ToolTipService.ToolTip="{helpers:ResourceString Name=AttachFile}">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE16C;" />
                        </Button>

                        <ComboBox
                            x:Name="SimComboBox"
                            AutomationProperties.Name="{x:Bind ViewModel.SelectedPhoneNumber.Number, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.ActiveDevice.PhoneNumbers, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedPhoneNumber, Mode=TwoWay}"
                            Style="{StaticResource SimIconComboBoxStyle}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SelectedPhoneNumber.Number, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowSimPicker, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:PhoneNumber">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid>
                                            <FontIcon
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="16"
                                                Glyph="{x:Bind Glyph}" />
                                            <FontIcon
                                                Margin="7,0,0,0"
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="16"
                                                Glyph="&#xED2A;" />
                                        </Grid>
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            Text="{x:Bind Number}"
                                            Visibility="{Binding IsDropDownOpen, ElementName=SimComboBox, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Border Width="1" Height="16" VerticalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Button
                            x:Name="SendButton"
                            AutomationProperties.Name="{helpers:ResourceString Name=SendButton}"
                            Click="SendButton_Click"
                            IsEnabled="{x:Bind ViewModel.CanSend, Mode=OneWay}"
                            Style="{StaticResource ComposerSendButtonStyle}"
                            ToolTipService.ToolTip="{helpers:ResourceString Name=SendButton}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
