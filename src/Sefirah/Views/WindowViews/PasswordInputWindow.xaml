<Window
    x:Class="Sefirah.Views.WindowViews.PasswordInputWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Sefirah.Helpers"
    Title="{helpers:ResourceString Name=EnterPassword}">

    <Grid
        Padding="24"
        Background="{ThemeResource App.PageBackgroundBrush}"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            FontSize="20"
            FontWeight="SemiBold"
            Text="{helpers:ResourceString Name=EnterPassword}" />

        <TextBlock
            Grid.Row="1"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{helpers:ResourceString Name=EnterPasswordDescription}"
            TextWrapping="Wrap" />

        <PasswordBox
            x:Name="PasswordBox"
            Grid.Row="2"
            IsPasswordRevealButtonEnabled="True"
            KeyDown="PasswordBox_KeyDown"
            PlaceholderText="{helpers:ResourceString Name=EnterPassword}" />

        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                MinWidth="80"
                Click="CancelButton_Click"
                Content="{helpers:ResourceString Name=Cancel}" />
            <Button
                MinWidth="80"
                Click="OkButton_Click"
                Content="{helpers:ResourceString Name=OK}"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
